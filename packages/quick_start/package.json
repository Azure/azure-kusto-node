{
    "name": "azure-kusto-quick-start",
    "version": "8.0.0",
    "private": true,
    "description": "Quick start Node sample app",
    "type": "module",
    "main": "dist/main.js",
    "scripts": {
        "build": "tsc -b",
        "clean": "rimraf dist",
        "quick_start": "npm run build && node dist/main.js",
        "test": "npm run build && node --test test/*Test.mjs"
    },
    "nx": {
        "targets": {
            "build": {
                "outputs": [
                    "{projectRoot}/dist"
                ]
            }
        }
    },
    "engines": {
        "node": ">=22.12.0",
        "npm": ">=11.21.2 <12"
    },
    "dependencies": {
        "azure-kusto-data": "^8.0.0",
        "azure-kusto-ingest": "^8.0.0",
        "diff": "^5.1.0",
        "uuid": "^11.1.1"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "rimraf": "^6.1.4",
        "typescript": "^5.9.3"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Azure/azure-kusto-node.git"
    },
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/Azure/azure-kusto-node/issues"
    },
    "homepage": "https://github.com/Azure/azure-kusto-node#readme"
}
