{
    "compilerOptions": {
        "target": "ES2017",
        "module": "NodeNext",
        "esModuleInterop": true,
        "strict": true,
        "incremental": true,
        "sourceMap": true,
        "resolveJsonModule": true,
        "allowJs": false,
        "declaration": true,
        "declarationMap": true,
        "noUnusedParameters": true,
        "moduleResolution": "NodeNext",
        "rootDir": "src",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
        "types": ["node"],
        "lib": ["es2017", "DOM"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules"]
}
